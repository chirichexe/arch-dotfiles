// Niri equivalent of "hyprland/workspaces#rw": one module per workspace slot so each gets the
// same pill styling as Hyprland's buttons (see .niri-ws in the style). NiriWorkspaces.py keeps
// the slot files up to date and refreshes them with SIGRTMIN+8.
"group/niri_workspaces": {
	"orientation": "inherit",
	"modules": [
		"custom/niri_workspaces#rw",
		"custom/niri_ws#1", "custom/niri_ws#2", "custom/niri_ws#3", "custom/niri_ws#4", "custom/niri_ws#5",
		"custom/niri_ws#6", "custom/niri_ws#7", "custom/niri_ws#8", "custom/niri_ws#9", "custom/niri_ws#10"
	]
},
"custom/niri_workspaces#rw": {
	"exec": "$HOME/.config/hypr/scripts/NiriWorkspaces.py",
	"return-type": "json",
	"format": "{}"
},
"custom/niri_ws#1": {
	"exec": "[ -n \"$NIRI_SOCKET\" ] && cat \"$XDG_RUNTIME_DIR/waybar-niri-ws/1.json\" 2>/dev/null",
	"return-type": "json",
	"signal": 8,
	"interval": "once",
	"format": "{}",
	"on-click": "niri msg action focus-workspace 1",
	"on-scroll-up": "niri msg action focus-workspace-up",
	"on-scroll-down": "niri msg action focus-workspace-down"
},
