/* ---- https://github.com/chirichexe ---- */

// ### Chirichexe - Top (niri) ### //
// Modules defined below take precedence over the shared ones in the included files.
// The "#niri" variants drop the Hyprland-only actions (ChangeBlur, KooL settings, ...)
// and the groups have no drawer, so every module is always visible (only the
// Wi-Fi stats appear on hover).
{
"include": [
  "$HOME/.config/waybar/Modules",
  "$HOME/.config/waybar/ModulesWorkspaces",
  "$HOME/.config/waybar/ModulesCustom",
  "$HOME/.config/waybar/ModulesGroups",
  "$HOME/.config/waybar/UserModules",
  ],
"layer": "top",
"exclusive": true,
"passthrough": false,
"position": "top",
"spacing": 3,
"fixed-center": true,
"ipc": true,
"margin-top": 3,
"margin-left": 8,
"margin-right": 8,

"modules-left": [
	"custom/separator#blank",
	"custom/cava_mviz",
	"custom/separator#blank",
	"custom/playerctl",
	"custom/separator#blank_2",
	"niri/window",
	"custom/pomodoro"
	],

"modules-center": [
	"group/app#niri",
	"custom/separator#blank",
	"group/notify#niri",
	"custom/separator#dot-line",
	"group/niri_workspaces",
	"clock",
	"custom/separator#dot-line",
	"idle_inhibitor",
	],

"modules-right": [
	"tray",
	"group/network#niri",
	"custom/separator#dot-line",
	"group/laptop#niri",
	"custom/separator#dot-line",
	"group/mobo#niri",
	"custom/separator#line",
	"group/audio#niri",
	"custom/separator#dot-line",
	"custom/power#niri",
	],

// ---- Groups (always expanded, except the network drawer) ---- //

"group/app#niri": {
	"orientation": "inherit",
	"modules": [
		"custom/menu",
		"custom/light_dark",
		"custom/file_manager",
		"custom/tty",
		"custom/browser",
	]
},

"group/notify#niri": {
	"orientation": "inherit",
	"modules": [
		"custom/swaync#niri",
		"custom/dot_update",
	]
},

"group/laptop#niri": {
	"orientation": "inherit",
	"modules": [
		"backlight",
		"battery#niri",
	]
},

"group/mobo#niri": {
	"orientation": "inherit",
	"modules": [
		"memory",
		"cpu",
		"power-profiles-daemon",
		"temperature",
		"disk",
	]
},

"group/audio#niri": {
	"orientation": "inherit",
	"modules": [
		"pulseaudio",
		"pulseaudio#microphone",
	]
},

"group/network#niri": {
	"orientation": "inherit",
	"drawer": {
		"transition-duration": 300,
		"children-class": "network-stats",
		"transition-left-to-right": false
	},
	"modules": [
		"network",
		"network#stats",
	]
},

// ---- Overrides ---- //

// Wi-Fi stats, only shown while hovering the network icon (group/network#niri)
"network#stats": {
	"interval": 1,
	"format": "",
	"format-wifi": "{essid}  󰕒 {bandwidthUpBytes}  󰇚 {bandwidthDownBytes}",
	"format-ethernet": "{ifname}  󰕒 {bandwidthUpBytes}  󰇚 {bandwidthDownBytes}",
	"format-disconnected": "",
	"tooltip-format-wifi": "{essid} {signalStrength}%\n{ipaddr}",
	"tooltip-format-ethernet": "{ifname}\n{ipaddr}",
},

"custom/swaync#niri": {
	"tooltip": true,
	"tooltip-format": "Left Click: Launch Notification Center\nRight Click: Do not Disturb",
	"format": "{} {icon} ",
	"format-icons": {
		"notification": "<span foreground='red'><sup></sup></span>",
		"none": "",
		"dnd-notification": "<span foreground='red'><sup></sup></span>",
		"dnd-none": "",
		"inhibited-notification": "<span foreground='red'><sup></sup></span>",
		"inhibited-none": "",
		"dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
		"dnd-inhibited-none": ""
	},
	"return-type": "json",
	"exec-if": "which swaync-client",
	"exec": "swaync-client -swb",
	"on-click": "sleep 0.1 && swaync-client -t -sw",
	"on-click-right": "swaync-client -d -sw",
	"escape": true,
},

"battery#niri": {
	"align": 0,
	"rotate": 0,
	"full-at": 100,
	"design-capacity": false,
	"states": {
		"good": 95,
		"warning": 30,
		"critical": 15
	},
	"format": "{icon} {capacity}%",
	"format-charging": " {capacity}%",
	"format-plugged": "󱘖 {capacity}%",
	"format-alt-click": "click",
	"format-full": "{icon} Full",
	"format-alt": "{icon} {time}",
	"format-icons": [
		"󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"
	],
	"format-time": "{H}h {M}min",
	"tooltip": true,
	"tooltip-format": "{timeTo} {power}w",
	"on-click-right": "$HOME/.config/hypr/scripts/Wlogout.sh",
},

"custom/power#niri": {
	"format": " ⏻ ",
	"on-click": "$HOME/.config/hypr/scripts/Wlogout.sh",
	"tooltip": true,
	"tooltip-format": "Left Click: Logout Menu",
},
}
