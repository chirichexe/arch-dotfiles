// /* wallust template - colors-niri */
// Generated by wallust; included by ~/.config/niri/config.kdl (same roles as Hyprland's
// UserDecorations.lua: active border = color12, inactive border = color10).

layout {
    focus-ring {
        active-color "#{{color12 | strip}}"
        inactive-color "#{{color10 | strip}}"
    }
    border {
        active-color "#{{color12 | strip}}"
        inactive-color "#{{color10 | strip}}"
    }
}

overview {
    backdrop-color "#{{background | strip}}"
}
