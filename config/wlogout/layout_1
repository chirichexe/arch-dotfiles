{
    "label": "lock",
    "action": "$HOME/.config/hypr/scripts/LockScreen.sh",
    "text": "Lock",
    "keybind": "l"
}

{
    "label": "logout",
    "action": "$HOME/.config/hypr/scripts/Logout.sh",
    "text": "Logout",
    "keybind": "e"
}

{
    "label": "suspend",
    "action": "$HOME/.config/hypr/scripts/LockScreen.sh; sleep 1; systemctl suspend",
    "text": "Suspend",
    "keybind": "u"
}

{
    "label": "shutdown",
    "action": "systemctl poweroff",
    "text": "Shutdown",
    "keybind": "s"
}

{
    "label": "reboot",
    "action": "systemctl reboot",
    "text": "Reboot",
    "keybind": "r"
}
